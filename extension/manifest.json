{
  "manifest_version": 3,
  "name": "AriaDM — Video & Multi-thread Downloader",
  "version": "1.0.0",
  "description": "Tự động bắt link video HLS, DASH, MP4, YouTube và tải đa luồng 16 kết nối bằng aria2c & yt-dlp.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "AriaDM Video Downloader"
  },
  "permissions": [
    "webRequest",
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
